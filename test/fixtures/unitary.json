{
    "conversations_surveys": {
        "tag": "surveys",
        "url": "/api/v2/quality/conversations/{conversationId}/surveys",
        "type": "unitary",
        "method": "GET",
        "path": "conversations_surveys",
        "result_data": "state"
    },
    "users_managment_unit": {
        "url": "/api/v2/workforcemanagement/managementunits/{mu_id}/users",
        "type": "unitary",
        "method": "GET",
        "path": "users_managment_unit",
        "result_data": "state"
    },
    "adherence_historical_init": {
        "url": "/api/v2/workforcemanagement/adherence/historical/bulk",
        "tag": "funcionarios_adherencia",
        "type": "init",
        "method": "POST",
        "path": "adherence_details",
        "body_templante": {
            "items": [
                {
                    "managementUnitId": "{mu_id}",
                    "startDate": "{star_date}",
                    "endDate": "{end_date}",
                    "includeExceptions": true,
                    "includeActuals": true
                }
            ],
            "timeZone": "America/Bogota"
        },
        "result_data": "jobId"
    },
    "transcripts_search": {
        "tag": "transcripts",
        "url": "/api/v2/speechandtextanalytics/transcripts/search",
        "type": "unitary",
        "method": "POST",
        "path": "transcripts_search",
        "body_templante": {
            "pageSize": "{page_size}",
            "pageNumber": "{page_number}",
            "interval": "{time_intervals}",
            "types": ["transcripts"],
            "query": [
                {"type": "EXACT", "fields": ["mediaType"], "value": "call"},
                {"type": "EXACT", "fields": ["language"], "value": "es-us"},
                {"type": "EXACT", "fields": ["divisionId"], "value": "{divisionId}"}
            ],
            "returnFields": ["conversationId", "communicationId"]
        },
        "result_data": "state"
    },
    "transcripts_url": {
        "tag": "transcripts",
        "url": "/api/v2/speechandtextanalytics/conversations/{conversationId}/communications/{communicationId}/transcripturl",
        "type": "url",
        "method": "GET",
        "path": "transcripts_url",
        "result_data": "state"
    }
}
